#include <LiquidCrystal.h>

// ============================================================
// LCD
// ============================================================
LiquidCrystal lcd(7, 8, 9, 10, 11, 12);


// ============================================================
// PINS
// ============================================================
const int SENSOR_PIN = A0;
const int BUZZER_PIN = 6;


// ============================================================
// SENSOR SETTINGS
// ============================================================

// Start LOW because we are using a buzzer as a makeshift
// piezo sensor.
const int STRUM_THRESHOLD = 15;

// Sensor must fall below this before another hit is allowed.
const int RESET_THRESHOLD = 5;

// Minimum time between hits.
const unsigned long DEBOUNCE_TIME = 150;


// ============================================================
// TEMPO SETTINGS
// ============================================================
const int START_BPM = 60;
const int TARGET_BPM = 120;

const int BPM_STEP = 10;

const int STRUMS_TO_ADVANCE = 8;

// Allow +/- 150 ms from the expected beat.
const unsigned long TIMING_TOLERANCE_MS = 150;


// ============================================================
// BUZZER
// ============================================================
const int BUZZER_FREQUENCY = 1500;
const int BUZZER_DURATION = 40;


// ============================================================
// INACTIVITY
// ============================================================
const unsigned long INACTIVITY_TIMEOUT = 10000;


// ============================================================
// VARIABLES
// ============================================================
int currentBPM;

unsigned long metronomeInterval;

unsigned long lastMetronomeClick = 0;
unsigned long lastStrumTime = 0;
unsigned long lastHitTime = 0;

int accurateStrumStreak = 0;

bool sensorReady = true;


// ============================================================
// SETUP
// ============================================================
void setup() {

  Serial.begin(9600);

  lcd.begin(16, 2);

  pinMode(BUZZER_PIN, OUTPUT);

  currentBPM = START_BPM;

  metronomeInterval = 60000UL / currentBPM;

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Guitar Metronome");

  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  delay(1000);

  lastMetronomeClick = millis();

  displayStatus();
}


// ============================================================
// MAIN LOOP
// ============================================================
void loop() {

  unsigned long now = millis();

  int sensorValue = analogRead(SENSOR_PIN);


  // ==========================================================
  // DEBUG
  // ==========================================================

  Serial.print("Sensor = ");
  Serial.println(sensorValue);


  // ==========================================================
  // RE-ARM SENSOR
  // ==========================================================

  if (sensorValue <= RESET_THRESHOLD) {

    sensorReady = true;
  }


  // ==========================================================
  // DETECT HIT
  // ==========================================================

  if (
    sensorValue >= STRUM_THRESHOLD &&
    sensorReady &&
    now - lastHitTime >= DEBOUNCE_TIME
  ) {

    Serial.println("******** HIT DETECTED ********");

    processStrum(now);

    sensorReady = false;

    lastHitTime = now;
  }


  // ==========================================================
  // METRONOME
  // ==========================================================

  if (now - lastMetronomeClick >= metronomeInterval) {

    tone(
      BUZZER_PIN,
      BUZZER_FREQUENCY,
      BUZZER_DURATION
    );

    lastMetronomeClick += metronomeInterval;
  }


  // ==========================================================
  // INACTIVITY
  // ==========================================================

  if (
    lastStrumTime != 0 &&
    now - lastStrumTime >= INACTIVITY_TIMEOUT
  ) {

    accurateStrumStreak = 0;

    lastStrumTime = 0;

    sensorReady = true;

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("Paused");

    lcd.setCursor(0, 1);
    lcd.print("No strums");

    delay(500);

    displayStatus();
  }
}


// ============================================================
// PROCESS STRUM
// ============================================================
void processStrum(unsigned long now) {

  // ----------------------------------------------------------
  // FIRST HIT
  // ----------------------------------------------------------

  if (lastStrumTime == 0) {

    lastStrumTime = now;

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("HIT!");

    lcd.setCursor(0, 1);
    lcd.print("First strum");

    Serial.println("FIRST STRUM");

    delay(100);

    displayStatus();

    return;
  }


  // ----------------------------------------------------------
  // TIME BETWEEN HITS
  // ----------------------------------------------------------

  unsigned long interval = now - lastStrumTime;

  unsigned long expectedInterval =
    60000UL / currentBPM;

  long timingError =
    (long)interval - (long)expectedInterval;


  // ----------------------------------------------------------
  // DEBUG
  // ----------------------------------------------------------

  Serial.print("Hit interval: ");
  Serial.print(interval);

  Serial.print(" ms | Expected: ");
  Serial.print(expectedInterval);

  Serial.print(" ms | Error: ");
  Serial.print(timingError);

  Serial.println(" ms");


  // ----------------------------------------------------------
  // TIMING CHECK
  // ----------------------------------------------------------

  if (abs(timingError) <= (long)TIMING_TOLERANCE_MS) {

    accurateStrumStreak++;

    Serial.print("GOOD HIT! Streak = ");
    Serial.println(accurateStrumStreak);

  } else {

    accurateStrumStreak = 0;

    Serial.println("BAD TIMING - STREAK RESET");
  }


  // ----------------------------------------------------------
  // SAVE TIME
  // ----------------------------------------------------------

  lastStrumTime = now;


  // ----------------------------------------------------------
  // TEMPO UP
  // ----------------------------------------------------------

  if (
    accurateStrumStreak >= STRUMS_TO_ADVANCE &&
    currentBPM < TARGET_BPM
  ) {

    currentBPM += BPM_STEP;

    if (currentBPM > TARGET_BPM) {
      currentBPM = TARGET_BPM;
    }

    metronomeInterval =
      60000UL / currentBPM;

    accurateStrumStreak = 0;

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("TEMPO UP!");

    lcd.setCursor(0, 1);
    lcd.print(currentBPM);
    lcd.print(" BPM");

    Serial.print("TEMPO UP -> ");
    Serial.println(currentBPM);

    delay(600);
  }


  displayStatus();
}


// ============================================================
// DISPLAY STATUS
// ============================================================
void displayStatus() {

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Tempo: ");
  lcd.print(currentBPM);
  lcd.print(" BPM");

  lcd.setCursor(0, 1);
  lcd.print("Streak: ");
  lcd.print(accurateStrumStreak);
  lcd.print("/");
  lcd.print(STRUMS_TO_ADVANCE);
}
